{
  "name": "ai-ide",
  "version": "0.1.0",
  "description": "Multi-provider AI coding IDE (Electron + React + TypeScript). Bring your own Google AI Studio, NVIDIA NIM, and Groq API keys.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "tsc -p electron/tsconfig.json && electron dist-electron/main.js",
    "build": "tsc && vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "start": "npm run build && npm run build:electron && electron dist-electron/main.js",
    "package": "npm run build && npm run build:electron && electron-builder --win",
    "rebuild": "electron-builder install-app-deps"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2",
    "@monaco-editor/react": "^4.6.0",
    "monaco-editor": "^0.49.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "node-pty": "^1.0.0",
    "lucide-react": "^0.383.0",
    "diff": "^5.2.0",
    "react-markdown": "^9.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.14.9",
    "@types/diff": "^5.2.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^3.4.4",
    "postcss": "^8.4.38",
    "autoprefixer": "^10.4.19"
  },
  "build": {
    "appId": "com.aether.aiide",
    "productName": "AI IDE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI IDE"
    }
  }
}
